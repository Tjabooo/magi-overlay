# systemd user unit: ~/.config/systemd/user/magi-overlay.service
# systemctl --user daemon-reload && systemctl --user enable --now magi-overlay
[Unit]
Description=magi-overlay stream overlay server
After=graphical-session.target network-online.target

[Service]
ExecStart=%h/.local/bin/magi-overlay serve
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
